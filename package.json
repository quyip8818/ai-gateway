{
  "name": "ai-gateway",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && node --env-file-if-exists=.env dist/server.js --replace-listener",
    "test": "npm run build && node --test app/backend/test/*.test.mjs",
    "deploy": "docker compose --env-file deploy/.env -f deploy/compose.yaml up -d --build",
    "lint": "oxlint --deny-warnings app shared build.mjs"
  },
  "type": "module",
  "dependencies": {
    "@koa/router": "15.7.1",
    "axios": "1.21.1",
    "crc-32": "1.2.2",
    "koa": "2.16.4",
    "koa-body": "5.0.0",
    "lodash": "4.18.1",
    "pg": "8.19.0",
    "randomstring": "1.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "uuid": "14.0.3",
    "yaml": "2.8.3"
  },
  "optionalDependencies": {
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.0",
    "oxlint": "1.95.0"
  }
}
