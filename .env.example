# Local pnpm start
# ACCOUNT_PROVIDERS_FILE=/path/to/private/providers.json
# ACCOUNT_EXECUTORS_FILE=/path/to/private/executors.json
# ACCOUNT_OAUTH_CLIENTS_FILE=/path/to/private/oauth-clients.json
# CODEX_ACCOUNT_BASE_URL=
# KIRO_ACCOUNT_BASE_URL=
# CLAUDE_ACCOUNT_BASE_URL=
# JIMENG_ACCOUNT_BASE_URL=
JIMENG_DOWNLOAD_HOSTS=

# Optional overrides
# HTTP_ADDR=127.0.0.1:32270
# PUBLIC_BASE_URL=http://127.0.0.1:32270
# MEDIA_STORAGE_DIR=./data/media
# POSTGRES_BIN=/path/to/postgresql/bin

# For an existing PostgreSQL database, set all three values.
# DATABASE_URL=postgres://gateway:password@127.0.0.1:5432/gateway
# KEY_DIGEST_SECRET=
# CONNECTION_SECRET=
