# SSH deployment target
DEPLOY_HOST=
DEPLOY_SSH_PORT=22
DEPLOY_USER=ubuntu
DEPLOY_PORT=8088

# Public URL used by the browser. For direct access over an SSH tunnel,
# use the loopback URL at the forwarded port.
PUBLIC_BASE_URL=http://127.0.0.1:8088

# Keep these three values stable across deploys.
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -base64 32, once for each key
KEY_DIGEST_SECRET=
CONNECTION_SECRET=

# Initial administrator. Set a password with 12 to 72 bytes for the first deploy.
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=

# Optional private Docker network and existing configuration directory on DEPLOY_HOST.
# JIMENG_NETWORK=account-executors
# ACCOUNT_CONFIG_DIR=/srv/ai-gateway/accounts
# CODEX_ACCOUNT_BASE_URL=
# KIRO_ACCOUNT_BASE_URL=
# CLAUDE_ACCOUNT_BASE_URL=
# JIMENG_ACCOUNT_BASE_URL=
JIMENG_DOWNLOAD_HOSTS=
